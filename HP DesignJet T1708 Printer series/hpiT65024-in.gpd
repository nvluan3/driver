*%******************************************************************************
*%                              GPD Name and Version Section
*%******************************************************************************
*GPDFileName: "hpiT65024-in.gpd"
*GPDFileVersion: "1.0"
*GPDSpecVersion: "1.0"
*ModelName: "HP DesignJet T650 24-in"
*PrinterType: PAGE
*MasterUnits: PAIR(1200,1200)
*MaxCopies: 9999
*Include: "hpinames.gpd"
*Include: "STDNAMES.gpd"
*Include: "MSXPSINC.gpd"
*Include: "locale.gpd"
*ResourceDLL: "hpires.dll"
*PrintSchemaPrivateNamespaceURI: "http://schemas.hp.com/lfp/ptpc/2006/1"
*Command: CmdSendBlockData { *Cmd : "" }

