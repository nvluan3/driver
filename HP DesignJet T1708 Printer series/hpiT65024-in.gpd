   }

   *Option: 600dpi
   {
      *rcNameID: =IDS_RESOLUTION_600DPI
      *DPI: PAIR(600, 600)
      *TextDPI: PAIR(600, 600)
      *SpotDiameter: 100
   }

   *Option: 1200dpi
   {
      *rcNameID: =IDS_RESOLUTION_1200DPI
      *DPI: PAIR(1200, 1200)
      *TextDPI: PAIR(1200, 1200)
      *SpotDiameter: 100
   }

}

*Command: CmdCR { *Cmd : "" }
