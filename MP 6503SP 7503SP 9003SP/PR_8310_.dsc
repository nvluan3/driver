[DrvInst]
DrvInst=infotec Pro 8310 PCL 6,infotec Pro 8320 PCL 6,LANIER Pro 8310 PCL 6,LANIER Pro 8320 PCL 6,NRG Pro 8310 PCL 6,NRG Pro 8320 PCL 6,RICOH Pro 8310 PCL 6,RICOH Pro 8320 PCL 6,SAVIN Pro 8310 PCL 6,SAVIN Pro 8320 PCL 6
Comment="PCL6 Driver (For Windows)"
DriverType=PCL6
DriverArchitecture=ARC2010ALFA
Version=3
IniFileName=rpdinstv.ini,allusers
IniFileSupport=4
ScenarioInstallOK=ON
RConfigFileOSVersion=3
DriverVersion=3.3.0.0
Platform=NTamd64
RCFFormatVersion=1.0
UserCodeOK=ON
ModelName.infotec Pro 8310 PCL 6 = "Pro 8310"
ModelName.infotec Pro 8320 PCL 6 = "Pro 8320"
ModelName.LANIER Pro 8310 PCL 6 = "Pro 8310"
ModelName.LANIER Pro 8320 PCL 6 = "Pro 8320"
ModelName.NRG Pro 8310 PCL 6 = "Pro 8310"
ModelName.NRG Pro 8320 PCL 6 = "Pro 8320"
ModelName.RICOH Pro 8310 PCL 6 = "Pro 8310"
ModelName.RICOH Pro 8320 PCL 6 = "Pro 8320"
ModelName.SAVIN Pro 8310 PCL 6 = "Pro 8310"
ModelName.SAVIN Pro 8320 PCL 6 = "Pro 8320"
USBPermit=ON
UserIDSupportLevel=1
PackageInstall=ON
IniFileCharacterSet=UTF8
PopupLockSupport=ON
WatermarkCustomizeSupport=ON
EnableSNMP=OFF
NXIdentify=1
