[Version]
Signature   = "$Windows NT$"
Provider    = %Ricoh%
ClassGUID   = {4D36E979-E325-11CE-BFC1-08002BE10318}
Class       = Printer
DriverVer	= 03/10/2026,3.3.0.0
CatalogFile	= RICOHJBP.cat

[Manufacturer]
%LANIER%=LANIER,NTamd64
%Ricoh%=Ricoh,NTamd64
%SAVIN%=SAVIN,NTamd64


;WindowsXP(amd64)
[LANIER.NTamd64]
"LANIER SP C360DNw PCL 6"=LANIER_SP_C360DNw_64.dat,USBPRINT\LANIERSP_C360DNwC74F,LPTENUM\LANIERSP_C360DNwC74F,LANIERSP_C360DNwC74F

[Ricoh.NTamd64]
"RICOH SP C360DNw PCL 6"=RICOH_SP_C360DNw_64.dat,USBPRINT\RICOHSP_C360DNw989A,LPTENUM\RICOHSP_C360DNw989A,RICOHSP_C360DNw989A

[SAVIN.NTamd64]
"SAVIN SP C360DNw PCL 6"=SAVIN_SP_C360DNw_64.dat,USBPRINT\SAVINSP_C360DNw86F7,LPTENUM\SAVINSP_C360DNw86F7,SAVINSP_C360DNw86F7


[LANIER_SP_C360DNw_64.dat]
CopyFiles	= RPD_FILES,RPD_COMMON,RPD_COMMON_SYS32
DataSection	= RPD_DATA
DataFile	= rica3Xcd.psz
LanguageMonitor	= rica3Xlm,rica3Xlm.dll

[RICOH_SP_C360DNw_64.dat]
CopyFiles	= RPD_FILES,RPD_COMMON,RPD_COMMON_SYS32
DataSection	= RPD_DATA
DataFile	= rica3Xcd.psz
LanguageMonitor	= rica3Xlm,rica3Xlm.dll

[SAVIN_SP_C360DNw_64.dat]
CopyFiles	= RPD_FILES,RPD_COMMON,RPD_COMMON_SYS32
DataSection	= RPD_DATA
DataFile	= rica3Xcd.psz
LanguageMonitor	= rica3Xlm,rica3Xlm.dll


[LANIER_SP_C360DNw_64.dat.Services]
AddService = ,0x2 

[RICOH_SP_C360DNw_64.dat.Services]
AddService = ,0x2 

[SAVIN_SP_C360DNw_64.dat.Services]
AddService = ,0x2 


