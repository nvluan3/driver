[DrvInst]
DrvInst=LANIER P 501 PCL 6,LANIER P 502 PCL 6,RICOH P 501 PCL 6,RICOH P 502 PCL 6,SAVIN P 501 PCL 6,SAVIN P 502 PCL 6
Comment="PCL6 Driver (For Windows)"
DriverType=PCL6
DriverArchitecture=ARC2010ALFA
Version=3
IniFileName=rpdinstv.ini,allusers
IniFileSupport=4
ScenarioInstallOK=ON
RConfigFileOSVersion=3
DriverVersion=3.3.0.0
Platform=NTamd64
RCFFormatVersion=1.0
UserCodeOK=ON
ModelName.LANIER P 501 PCL 6 = "P 501"
ModelName.LANIER P 502 PCL 6 = "P 502"
ModelName.RICOH P 501 PCL 6 = "P 501"
ModelName.RICOH P 502 PCL 6 = "P 502"
ModelName.SAVIN P 501 PCL 6 = "P 501"
ModelName.SAVIN P 502 PCL 6 = "P 502"
USBPermit=ON
UserIDSupportLevel=1
PackageInstall=ON
IniFileCharacterSet=UTF8
PopupLockSupport=ON
EnableSNMP=OFF
USBNullDriverInfFileName=RPRNUT.INF
NXIdentify=1
