ModelName.RICOH MP C407 PCL 6 = "MP C407"
ModelName.SAVIN MP C307 PCL 6 = "MP C307"
ModelName.SAVIN MP C407 PCL 6 = "MP C407"
USBPermit=ON
UserIDSupportLevel=1
PackageInstall=ON
PopupLockSupport=ON
