ModelName.NRG MP C8003 PCL 6 = "MP C8003"
ModelName.RICOH MP C6503 PCL 6 = "MP C6503"
ModelName.RICOH MP C8003 PCL 6 = "MP C8003"
ModelName.SAVIN MP C6503 PCL 6 = "MP C6503"
ModelName.SAVIN MP C8003 PCL 6 = "MP C8003"
USBPermit=ON
