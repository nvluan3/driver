[Version]
Signature   = "$Windows NT$"
Provider    = %Ricoh%
ClassGUID   = {4D36E979-E325-11CE-BFC1-08002BE10318}
Class       = Printer
DriverVer	= 03/10/2026,3.3.0.0
CatalogFile	= RICOHJBP.cat

[Manufacturer]
%LANIER%=LANIER,NTamd64
%NRG%=NRG,NTamd64
%Ricoh%=Ricoh,NTamd64
%SAVIN%=SAVIN,NTamd64


;WindowsXP(amd64)
[LANIER.NTamd64]
"LANIER SP 8400DN PCL 6"=LANIER_SP_8400DN_64.dat,USBPRINT\LANIERSP_8400DNB5C0,LPTENUM\LANIERSP_8400DNB5C0,LANIERSP_8400DNB5C0

[NRG.NTamd64]
