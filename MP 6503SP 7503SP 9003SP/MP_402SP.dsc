ModelName.infotec MP 402SPF PCL 6 = "MP 402SPF"
ModelName.LANIER MP 402SPF PCL 6 = "MP 402SPF"
ModelName.NRG MP 402SPF PCL 6 = "MP 402SPF"
ModelName.RICOH MP 402SPF PCL 6 = "MP 402SPF"
ModelName.SAVIN MP 402SPF PCL 6 = "MP 402SPF"
USBPermit=ON
UserIDSupportLevel=1
PackageInstall=ON
PopupLockSupport=ON
NXIdentify=1
