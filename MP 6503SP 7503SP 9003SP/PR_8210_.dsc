[DrvInst]
DrvInst=infotec Pro 8210 PCL 6,infotec Pro 8220 PCL 6,LANIER Pro 8210 PCL 6,LANIER Pro 8220 PCL 6,NRG Pro 8210 PCL 6,NRG Pro 8220 PCL 6,RICOH Pro 8210 PCL 6,RICOH Pro 8220 PCL 6,SAVIN Pro 8210 PCL 6,SAVIN Pro 8220 PCL 6
Comment="PCL6 Driver (For Windows)"
DriverType=PCL6
DriverArchitecture=ARC2010ALFA
Version=3
IniFileName=rpdinstv.ini,allusers
IniFileSupport=4
ScenarioInstallOK=ON
RConfigFileOSVersion=3
DriverVersion=3.3.0.0
Platform=NTamd64
RCFFormatVersion=1.0
UserCodeOK=ON
ModelName.infotec Pro 8210 PCL 6 = "Pro 8210"
ModelName.infotec Pro 8220 PCL 6 = "Pro 8220"
ModelName.LANIER Pro 8210 PCL 6 = "Pro 8210"
ModelName.LANIER Pro 8220 PCL 6 = "Pro 8220"
ModelName.NRG Pro 8210 PCL 6 = "Pro 8210"
ModelName.NRG Pro 8220 PCL 6 = "Pro 8220"
ModelName.RICOH Pro 8210 PCL 6 = "Pro 8210"
ModelName.RICOH Pro 8220 PCL 6 = "Pro 8220"
ModelName.SAVIN Pro 8210 PCL 6 = "Pro 8210"
ModelName.SAVIN Pro 8220 PCL 6 = "Pro 8220"
USBPermit=ON
UserIDSupportLevel=1
PackageInstall=ON
PopupLockSupport=ON
NXIdentify=1
