[DrvInst]
DrvInst=LANIER SP C360DNw PCL 6,RICOH SP C360DNw PCL 6,SAVIN SP C360DNw PCL 6
Comment="PCL6 Driver (For Windows)"
DriverType=PCL6
DriverArchitecture=ARC2010ALFA
Version=3
IniFileName=rpdinstv.ini,allusers
IniFileSupport=4
ScenarioInstallOK=ON
RConfigFileOSVersion=3
DriverVersion=3.3.0.0
Platform=NTamd64
RCFFormatVersion=1.0
UserCodeOK=ON
ModelName.LANIER SP C360DNw PCL 6 = "SP C360DNw"
ModelName.RICOH SP C360DNw PCL 6 = "SP C360DNw"
ModelName.SAVIN SP C360DNw PCL 6 = "SP C360DNw"
USBPermit=ON
UserIDSupportLevel=1
PackageInstall=ON
PopupLockSupport=ON
NXIdentify=1
